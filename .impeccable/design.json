      "html": "<button class=\"ds-primary ds-focus\" type=\"button\">Explorar missões</button>",
      "css": ".ds-primary{display:inline-flex;min-height:44px;align-items:center;justify-content:center;padding:12px 20px;border-radius:12px;font-size:14px;font-weight:600;line-height:20px;text-align:center;cursor:pointer;font-family:var(--font-sans,'Segoe UI',system-ui,sans-serif);transition:background-color 150ms cubic-bezier(0.4,0,0.2,1),color 150ms cubic-bezier(0.4,0,0.2,1);gap:8px;border:0;background:var(--color-brand,#087f68);color:var(--color-white,#fff);}.ds-primary:hover{background:var(--color-ink,#111c3d);}.ds-primary:disabled{background:var(--color-slate-200,oklch(92.9% 0.013 255.508));color:var(--color-slate-600,oklch(44.6% 0.043 257.281));cursor:not-allowed;}.ds-focus:focus-visible{outline:2px solid var(--color-brand,#087f68);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;}}"
