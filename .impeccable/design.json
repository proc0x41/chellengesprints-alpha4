      "kind": "input",
      "refersTo": "input",
      "description": "Campo operacional com rótulo acima, foco verde e ajuda abaixo.",
      "html": "<div class=\"ds-field\"><label class=\"ds-field-label\" for=\"ds-nickname\">Apelido</label><input class=\"ds-field-input ds-focus\" id=\"ds-nickname\" autocomplete=\"nickname\" minlength=\"2\" maxlength=\"80\" /><p class=\"ds-field-help\">O apelido poderá aparecer nos rankings. De 2 a 80 caracteres.</p></div>",
      "css": ".ds-field{font-family:var(--font-sans,'Segoe UI',system-ui,sans-serif);color:var(--color-ink,#111c3d);font-size:16px;line-height:24px;}.ds-field-label{font-weight:600;}.ds-field-input{display:block;margin-top:8px;min-height:44px;width:100%;max-width:100%;padding:12px 16px;border:1px solid var(--color-slate-300,oklch(86.9% 0.022 252.894));border-radius:12px;background:var(--color-white,#fff);color:var(--color-ink,#111c3d);font:inherit;caret-color:var(--color-brand,#087f68);}.ds-field-input:disabled{opacity:.6;}.ds-field-help{margin:8px 0 0;font-size:14px;line-height:24px;color:var(--color-slate-600,oklch(44.6% 0.043 257.281));}.ds-focus:focus-visible{outline:2px solid var(--color-brand,#087f68);outline-offset:4px;}"
    },
