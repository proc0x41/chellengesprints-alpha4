      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:4px;font-family:var(--font-sans,'Segoe UI',system-ui,sans-serif);}.ds-nav-link{display:flex;min-height:44px;align-items:center;padding:8px 12px;border-radius:8px;color:var(--color-slate-600,oklch(44.6% 0.043 257.281));font-size:14px;font-weight:600;line-height:20px;text-decoration:none;}.ds-nav-link:hover{background:var(--color-paper,#f4f6fb);color:var(--color-ink,#111c3d);}.ds-nav-link.ds-nav-active{background:var(--color-brand-light,#e5f6ef);color:var(--color-brand-strong,#066653);}.ds-focus:focus-visible{outline:2px solid var(--color-brand,#087f68);outline-offset:4px;}"
